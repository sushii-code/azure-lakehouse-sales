# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Data (never commit raw or generated data)
data/raw/*
data/simulated/*
!data/raw/.gitkeep
!data/simulated/.gitkeep
*.csv
*.parquet

# Secrets and local config
.env
*.tfvars
!example.tfvars
profiles.yml
# ...except the FAKE CI profile (no real host or token), which CI needs for dbt parse
!ci/profiles.yml
# Local helper that contains my workspace URL
scripts/set_databricks_env.ps1

# Terraform
# downloaded providers (re-created by terraform init)
.terraform/
# state files hold real resource ids and can hold secrets: never commit them
*.tfstate
*.tfstate.*
crash.log
# (*.tfvars is ignored above, under Secrets)
# .terraform.lock.hcl is NOT ignored: it pins the exact provider versions and must be committed

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
# dbt writes logs/ here if it is run from the repo root instead of dbt/
logs/

# OS / editor
.DS_Store
.vscode/
